{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On"
            }
        },
        {
            "name": "host-system",
            "displayName": "Host build (system dependencies)",
            "description": "Build and install the library using C++ dependencies already installed on the system.",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-system",
            "configurePreset": "host-system"
        }
    ],
    "workflowPresets": [
        {
            "name": "host-system",
            "steps": [
                {
                    "name": "host-system",
                    "type": "configure"
                },
                {
                    "name": "host-system",
                    "type": "build"
                }
            ]
        }
    ]
}
