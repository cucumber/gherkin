{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cucumber/gherkin",
    "description": "Gherkin parser",
    "authors": [
        {
            "name": "Cucumber Limited <cukes@googlegroups.com>"
        }
    ],
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Cucumber\\Gherkin\\": [
                "src/",
                "src-generated/"
            ]
        }
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "cucumber/messages": ">=34.0.0 <36"
    },
    "require-dev": {
        "vimeo/psalm": "^7",
        "phpunit/phpunit": "^13",
        "psalm/plugin-phpunit": "^1",
        "friendsofphp/php-cs-fixer": "^3"
    }
}
