{
    "name": "cucumber/gherkin",
    "description": "Gherkin parser",
    "author": "Cucumber Limited <cukes@googlegroups.com>",
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Cucumber\\Gherkin\\": [
                "src/",
                "src-generated/"
            ]
        }
    },
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "cucumber/messages": ">=34.0.0 <35"
    },
    "require-dev": {
        "vimeo/psalm": "^6",
        "phpunit/phpunit": "^13",
        "psalm/plugin-phpunit": "^0.20",
        "friendsofphp/php-cs-fixer": "^3"
    }
}
