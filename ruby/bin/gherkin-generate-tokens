#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.join(File.dirname(__FILE__), '../lib'))
require 'gherkin/parser'
require 'gherkin/token_formatter_builder'
require 'gherkin/token_matcher_markdown'
require 'gherkin/stream/parser_message_stream'

parser = Gherkin::Parser.new(Gherkin::TokenFormatterBuilder.new)
files = ARGV
files.each do |file|
  File.open(file, 'r:UTF-8') do |io|
    token_matcher = if Gherkin::Stream::ParserMessageStream.markdown_uri?(file)
                      Gherkin::GherkinInMarkdownTokenMatcher.new
                    else
                      Gherkin::TokenMatcher.new
                    end
    print parser.parse(io, token_matcher)
  end
end
